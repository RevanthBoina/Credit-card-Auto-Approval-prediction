# URL of the Flask backend, used server-side by app/api/predict/route.ts.
# The browser never sees this value directly.
FLASK_API_URL=http://127.0.0.1:8080

# OpenAI API key for the rejection explanation assistant (/api/explain).
# Server-side only. Copy this file to .env.local and paste your key there.
# .env.local is git-ignored, so the key is never committed.
# If unset, /api/explain falls back to a local rule-based explanation.
OPENAI_API_KEY=
